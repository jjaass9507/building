<?xml version="1.0" encoding="utf-8"?>
<!--
  部署範例設定檔（HttpPlatformHandler + Waitress）。

  === 路徑設定 ===
  下方所有 C:\inetpub\wwwroot\BuildingPlatform（共 4 處）都要換成這台 Server 上
  實際放置本專案的資料夾路徑。直接執行 scripts\deploy-iis.ps1 會自動完成替換，
  手動改也可以，但四處都要改到。

  === 為什麼用 HttpPlatformHandler 而不是 wfastcgi ===
  wfastcgi 已停止維護，Microsoft 官方建議改用 HttpPlatformHandler：
  由 IIS 直接管理 Python 程序的生命週期（自動啟動、崩潰重啟、停站時一併結束），
  不需要 NSSM / WinSW 之類的服務管理器。公司其他 Python 服務也都是這個架構。

  HttpPlatformHandler 不內建於 IIS，必須另外安裝 MSI：
  https://www.iis.net/downloads/microsoft/httpplatformhandler

  === 重要：IIS 驗證設定不寫在這裡 ===
  本平台的登入流程需要：
    應用程式根目錄  → 匿名驗證「啟用」＋ Windows 驗證「啟用」
    /auth/sso 路徑  → 匿名驗證「停用」＋ Windows 驗證「啟用」

  這樣做的原因：
    * 根目錄允許匿名 → 使用者按掉 Windows 帳密視窗時，request 仍會進到 Flask，
      由程式導向自家的登入畫面，不會再出現 IIS 的 401 錯誤頁。
    * /auth/sso 關閉匿名 → 網域內電腦仍可自動帶入 Windows 身分完成單一登入。

  anonymousAuthentication / windowsAuthentication 這兩個區段預設在
  applicationHost.config 是鎖定的，直接寫在 web.config 會噴 HTTP 500.19，
  所以請執行 scripts\setup-ad-login.ps1（以系統管理員身分）設定。

  === 重要：資料庫密碼不要寫在這個檔案裡 ===
  web.config 有進版控。PostgreSQL 的帳號密碼請放部署機的 .env（見 .env.example），
  該檔案已列入 .gitignore，只存在部署機上。
-->
<configuration>
  <system.webServer>

    <!-- 所有請求交給 HttpPlatformHandler，由它轉給 Waitress -->
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*" verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="C:\inetpub\wwwroot\BuildingPlatform\venv\Scripts\waitress-serve.exe"
        arguments="--port=%HTTP_PLATFORM_PORT% --threads=4 wsgi:application"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\inetpub\wwwroot\BuildingPlatform\logs\python.log"
        startupTimeLimit="60"
        startupRetryCount="3"
        requestTimeout="00:04:00"
        forwardWindowsAuthToken="true">
      <!--
        forwardWindowsAuthToken="true" 是 SSO 的關鍵：
        沒有這一行，IIS 的 Windows 驗證結果不會傳給 Python，
        app.py 的 username_from_windows_token() 就永遠收不到 X-IIS-WindowsAuthToken。
      -->

      <environmentVariables>
        <!-- 讓 Waitress 找得到 wsgi.py -->
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\BuildingPlatform" />
        <!-- 關掉 stdout 緩衝，否則 logs\python.log 會一直是空的 -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- 繁中 Windows 預設 cp950，遇到 emoji 或罕用字會直接崩潰，強制 UTF-8 -->
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />

        <!--
          === 掛載路徑 ===
          部署成「網站根目錄」時留空（預設）。
          部署成 IIS 子應用程式時，必須填該應用程式的路徑，例如：
              <environmentVariable name="APP_URL_PREFIX" value="/building_platform" />

          沒填的話，IIS 轉進來的 PATH_INFO 會帶著前綴，Flask 拿
          '/building_platform' 去比對只定義在 '/' 的路由，結果每一頁都是 404。
          填對之後前端也會自動跟上（後端把它寫進 window.APP_BASE）。

          scripts\deploy-iis.ps1 帶 -AppPath 時會自動填這個值。
        -->
        <environmentVariable name="APP_URL_PREFIX" value="" />

        <!--
          === AD 登入設定 ===
          AD_SERVER   ：LDAP 位址。用 NetBIOS 短名最單純，例如 ldap://ASE
          AD_DOMAIN   ：完整網域名稱（UPN 用），例如 ase.com.tw
          AD_NETBIOS  ：NetBIOS 網域名。留空時會自動從 AD_SERVER / AD_DOMAIN 推導
          APP_SSO_PROBE：是否啟用 Windows 單一登入探測（預設 true）。
                         設成 false 就只走 AD 帳密登入表單，不會彈 Windows 視窗。

          沒有設定 AD_SERVER 時，Windows 單一登入仍可運作，
          但登入頁的帳密登入會顯示「系統尚未設定 AD 伺服器」。
        -->
        <environmentVariable name="AD_SERVER"     value="ldap://ASE" />
        <environmentVariable name="AD_DOMAIN"     value="" />
        <environmentVariable name="AD_NETBIOS"    value="" />
        <environmentVariable name="APP_SSO_PROBE" value="true" />

        <!--
          APP_SECRET_KEY：session cookie 的簽章金鑰。
          多台機器要共用登入狀態時各台填同一組隨機字串；留空則自動產生 secret_key.txt。
          視為機密的話請改放 .env，不要寫在這裡。
        -->
        <environmentVariable name="APP_SECRET_KEY" value="" />

        <!--
          === 資料來源 ===
          json      ：地端 JSON 檔案（預設，行為與導入資料庫前完全相同）
          postgres  ：PostgreSQL

          切成 postgres 之前，請先跑過 scripts\run-migrations.ps1 與
          scripts\migrate_json_to_pg.py，並確認 hash 驗收通過。
          連線帳密放 .env，不要放這裡。
        -->
        <environmentVariable name="DATA_BACKEND" value="json" />
      </environmentVariables>

    </httpPlatform>
  </system.webServer>
</configuration>
