<?xml version="1.0" encoding="utf-8"?>
<!--
  部署範例設定檔。

  下方所有 APP_ROOT 路徑（共 4 處）都要換成「該台 Server 上實際放置本專案的資料夾路徑」，
  且必須與 IIS FastCGI 應用程式登錄（IIS Manager -> FastCGI 設定 / applicationHost.config）
  裡的 scriptProcessor 完全一致，否則網站無法啟動。

  範例值：
    APP_ROOT      = C:\inetpub\wwwroot\BuildingPlatform
    PYTHON_HOME   = %APP_ROOT%\PortablePython3.11.5   (若改用系統 Python，請指向該 Python 安裝目錄)

  === 重要：路徑含空白字元時 ===
  IIS 啟動 FastCGI 程序時，會把 scriptProcessor 的「參數」部分原封不動接到命令列後面。
  若路徑含空白（例如 D:\Web Service\...），Windows 會依空白拆解參數，Python 只會收到
  第一段（D:\Web），導致 can't open file 'D:\Web': [Errno 2]，IIS 則回報
  「FastCGI 處理序意外地結束」錯誤碼 0x00000002，且完全不會產生任何 log。

  因此 scriptProcessor 的 wfastcgi.py 部分「一律」用引號包住（XML 屬性內寫成 &quot;），
  如下方設定所示。IIS FastCGI 應用程式登錄（applicationHost.config）的 arguments
  欄位也必須帶同樣的引號，兩邊要完全一致。

  建議：盡量把專案放在「不含空白」的路徑，可省去這類問題。
-->
<configuration>
  <system.webServer>
        <!--
          === IIS 驗證設定 (請用 scripts\setup-ad-login.ps1 設定，不要寫在這裡) ===

          本平台的登入流程需要：
            應用程式根目錄  → 匿名驗證「啟用」＋ Windows 驗證「啟用」
            /auth/sso 路徑  → 匿名驗證「停用」＋ Windows 驗證「啟用」

          這樣做的原因：
            * 根目錄允許匿名 → 使用者按掉 Windows 帳密視窗時，request 仍會進到 Flask，
              由程式導向自家的登入畫面，不會再出現 IIS 的 401 錯誤頁。
            * /auth/sso 關閉匿名 → 網域內電腦仍可自動帶入 Windows 身分完成單一登入。

          anonymousAuthentication / windowsAuthentication 這兩個區段預設在
          applicationHost.config 是鎖定的，直接寫在 web.config 會噴 HTTP 500.19，
          所以請執行 scripts\setup-ad-login.ps1 (以系統管理員身分) 設定。
        -->
        <handlers>
            <!-- scriptProcessor 格式：{PYTHON_HOME}\python.exe|"{PYTHON_HOME}\wfastcgi.py" -->
            <add name="Python FastCGI" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\inetpub\wwwroot\BuildingPlatform\PortablePython3.11.5\python.exe|&quot;C:\inetpub\wwwroot\BuildingPlatform\PortablePython3.11.5\wfastcgi.py&quot;" resourceType="Unspecified" />
        </handlers>
  </system.webServer>

  <appSettings>
    <add key="WSGI_HANDLER" value="app.app" />
    <!-- PYTHONPATH：{APP_ROOT};{PYTHON_HOME}\stdlib -->
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\BuildingPlatform;C:\inetpub\wwwroot\BuildingPlatform\PortablePython3.11.5\stdlib" />
    <!-- WSGI_LOG：{APP_ROOT}\app.log -->
    <add key="WSGI_LOG" value="C:\inetpub\wwwroot\BuildingPlatform\app.log" />

    <!--
      === AD 登入設定 ===
      wfastcgi 會把 appSettings 轉成環境變數傳給 Python，所以直接在這裡設定即可。

      AD_SERVER   ：LDAP 位址。用 NetBIOS 網域名最單純，例如 ldap://ASE
      AD_DOMAIN   ：完整網域名稱 (UPN 用)，例如 ase.com.tw
      AD_NETBIOS  ：NetBIOS 網域名。留空時會自動從 AD_SERVER / AD_DOMAIN 推導
      APP_SECRET_KEY：session cookie 簽章金鑰。多台機器要共用登入狀態時，
                      各台請填同一組隨機字串；留空則自動產生 secret_key.txt
      APP_SSO_PROBE ：是否啟用 Windows 單一登入探測 (預設 true)。
                      設成 false 就只走 AD 帳密登入表單，完全不會彈 Windows 視窗。

      沒有設定 AD_SERVER 時，Windows 單一登入仍可運作，但登入頁的帳密登入會顯示
      「系統尚未設定 AD 伺服器」。
    -->
    <!-- ↓ 請改成貴公司實際的 NetBIOS 網域名 (與登入 Windows 時 網域\帳號 的網域部分相同) -->
    <add key="AD_SERVER" value="ldap://ASE" />
    <add key="AD_DOMAIN" value="" />
    <add key="AD_NETBIOS" value="" />
    <add key="APP_SECRET_KEY" value="" />
    <add key="APP_SSO_PROBE" value="true" />
  </appSettings>
</configuration>