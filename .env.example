# =============================================================================
# 部署機環境設定範本
#
# 用法：複製成 .env 放在專案根目錄，填入實際值。
#       .env 已列入 .gitignore，只會存在部署機上，不會進版控。
#
# 為什麼機密放這裡而不是 web.config：
#   web.config 是進版控的檔案，密碼寫進去就等於 commit 進 git。
# =============================================================================

# --- 資料來源 ----------------------------------------------------------------
# json      地端 JSON 檔案（預設，行為與導入資料庫前完全相同）
# postgres  PostgreSQL
#
# 切成 postgres 之前請先完成：
#   1. scripts\run-migrations.ps1      建立 schema
#   2. scripts\migrate_json_to_pg.py   匯入資料並通過 hash 驗收
DATA_BACKEND=json

# postgres 模式下，寫入是否同時鏡射回 JSON 檔（預設 true）。
#
# 開著的用意是保留退路：切換期間若資料庫出狀況，把 DATA_BACKEND 改回 json
# 重啟就能回到檔案版，而且檔案內容是最新的。
# 確認資料庫穩定之後（Phase 3）再設成 false 停掉鏡射。
DATA_MIRROR_JSON=true

# --- PostgreSQL 連線 ---------------------------------------------------------
# 兩種寫法擇一。密碼一律走 PGPASSWORD，不要寫進 DSN ——
# 這樣連線字串本身可以安心寫進 log 與錯誤訊息。

# 應用程式日常使用的帳號：只有 DML，不能改結構。
PGHOST=pg.example.corp
PGPORT=5432
PGDATABASE=building
PGUSER=svc_building_mgmt_rw
PGPASSWORD=

# 跑 migration 用的帳號：有 DDL 權限，擁有 schema 與物件。
# 有設定時，scripts\run-migrations.ps1 會改用這一組連線，
# 應用程式平常仍然用上面那組（只有 DML，權限最小）。
# 留空的話 migration 會沿用 PGUSER —— 那個帳號沒有 DDL 權限，會失敗。
#
# 兩個帳號都用 scripts\create-db-users.ps1 建立：
#     .\scripts\create-db-users.ps1 -AdminUser postgres
PGUSER_MIGRATOR=svc_building_mgmt_migrator
PGPASSWORD_MIGRATOR=

# 公司內網也走 TLS。PG 18 已棄用 md5，帳密認證會走 scram-sha-256；
# 搭配 channel binding 可以擋掉中間人轉發驗證。
PGSSLMODE=require
PGCHANNELBINDING=require

# 連線池。IIS 若開多個 worker process，每個 process 都有自己的池，
# 設定上限時要一起算進 DB 的連線數上限。
BUILDING_DB_POOL_MIN=1
BUILDING_DB_POOL_MAX=8
BUILDING_DB_POOL_TIMEOUT=15
PGCONNECT_TIMEOUT=10

# 也可以改用完整 DSN 取代上面的 PGHOST/PGPORT/PGDATABASE/PGUSER
# （密碼仍然放 PGPASSWORD）：
# BUILDING_DB_DSN=host=pg.example.corp port=5432 dbname=building user=building_app_svc sslmode=require

# --- AD 登入 -----------------------------------------------------------------
# 一般放在 web.config 的 environmentVariables 即可（非機密）。
# 若貴公司規範要求連 AD 位址都不落版控，改放這裡也可以。
# AD_SERVER=ldap://ASE
# AD_DOMAIN=ase.com.tw
# AD_NETBIOS=

# --- Session -----------------------------------------------------------------
# 多台機器要共用登入狀態時，各台填同一組隨機字串。
# 留空則由程式自動產生 secret_key.txt。
# APP_SECRET_KEY=

# --- 本機開發用（正式機請勿設定）---------------------------------------------
# 不連 AD，任何密碼都通過
# AD_MOCK=true
# 直接以這個身分登入，跳過驗證
# APP_DEV_USER=Local-Dev
